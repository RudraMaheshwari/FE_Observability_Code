# Base URL of the Python/FastAPI backend (observability_ui/backend/main.py).
NEXT_PUBLIC_API_BASE=http://localhost:8600

# --- Demo tab (Grafana) — server-side only; NOT exposed to the browser ---
# The "Demo" tab pulls a Grafana dashboard via the Grafana API (app/api/grafana/*),
# so the token never leaves the Next.js server.
GRAFANA_URL=https://your-grafana-host
GRAFANA_DASHBOARD_UID=your-dashboard-uid
GRAFANA_TOKEN=glsa_your_service_account_token
